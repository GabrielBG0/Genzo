{
  "name": "genzo-frontend",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint . && stylelint \"src/**/*.{css,svelte}\" && node scripts/check-colors.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "app:dev": "cd ../shell && tauri dev",
    "app:build": "cd ../shell && tauri build"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/public-sans": "5.3.0",
    "@tauri-apps/api": "2.12.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "26.6.5",
    "eslint": "10.12.0",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "postcss-html": "2.0.0",
    "stylelint": "17.16.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
